<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Para Bladimir 🖤</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #0a0a0a; color: #fff; overflow: hidden; height: 100vh; width: 100vw;
    }

    /* Lock Screen */
    #lock-screen {
      position: fixed; inset: 0;
      background: linear-gradient(180deg, #111 0%, #0a0a0a 100%);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      z-index: 1000; transition: opacity 0.6s ease, transform 0.6s ease;
    }
    #lock-screen.hidden { opacity: 0; transform: scale(1.1); pointer-events: none; }
    .lock-time { font-size: 72px; font-weight: 200; letter-spacing: -2px; margin-bottom: 8px; }
    .lock-date { font-size: 18px; opacity: 0.75; margin-bottom: 55px; }
    .pin-dots { display: flex; gap: 16px; margin-bottom: 45px; }
    .pin-dot {
      width: 13px; height: 13px; border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.5); transition: all 0.2s;
    }
    .pin-dot.filled { background: #fff; border-color: #fff; }
    .pin-pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; width: 270px; }
    .pin-btn {
      width: 72px; height: 72px; border-radius: 50%;
      background: rgba(255,255,255,0.1); border: none; color: white;
      font-size: 26px; display: flex; align-items: center; justify-content: center;
    }
    .pin-btn:active { background: rgba(255,255,255,0.25); }
    .pin-btn.empty { background: transparent; pointer-events: none; }
    .error-msg { color: #e63946; font-size: 14px; margin-top: 22px; height: 20px; opacity: 0; transition: opacity 0.3s; }
    .error-msg.show { opacity: 1; }

    /* Main */
    #main-content {
      position: fixed; inset: 0; display: none;
      background: linear-gradient(160deg, #0d0d0d 0%, #1a0a0a 50%, #0d0d0d 100%);
    }
    #main-content.active { display: block; }

    .explosion-box {
      position: absolute; top: 50%; left: 50%;
      width: 220px; height: 220px; transform: translate(-50%, -50%); z-index: 10;
    }
    .explosion-box.opened { width: 100%; height: 100%; top: 0; left: 0; transform: none; }

    .flap {
      position: absolute; width: 110px; height: 110px;
      background: linear-gradient(145deg, #c1121f, #9b0b14);
      border: 2px solid #e63946;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 8px; font-size: 11px; color: white;
      transition: all 0.9s cubic-bezier(0.4, 0, 0.2, 1); overflow: hidden; z-index: 5;
    }
    .flap.top { top: 0; left: 55px; border-radius: 12px 12px 0 0; transform-origin: bottom center; }
    .flap.right { top: 55px; right: 0; border-radius: 0 12px 12px 0; transform-origin: left center; }
    .flap.bottom { bottom: 0; left: 55px; border-radius: 0 0 12px 12px; transform-origin: top center; }
    .flap.left { top: 55px; left: 0; border-radius: 12px 0 0 12px; transform-origin: right center; }

    .explosion-box.opened .flap.top {
      top: 4%; left: 50%; transform: translateX(-50%); width: 155px; height: 155px; border-radius: 16px;
    }
    .explosion-box.opened .flap.right {
      top: 50%; right: 4%; transform: translateY(-50%); width: 155px; height: 155px; border-radius: 16px;
    }
    .explosion-box.opened .flap.bottom {
      bottom: 4%; left: 50%; transform: translateX(-50%); width: 155px; height: 155px; border-radius: 16px;
    }
    .explosion-box.opened .flap.left {
      top: 50%; left: 4%; transform: translateY(-50%); width: 155px; height: 155px; border-radius: 16px;
    }

    .box-center {
      position: absolute; top: 55px; left: 55px; width: 110px; height: 110px;
      background: #c1121f; border-radius: 10px;
      display: flex; align-items: center; justify-content: center; font-size: 40px;
      z-index: 6; box-shadow: 0 0 25px rgba(193,18,31,0.5); transition: all 0.5s; cursor: pointer;
    }
    .explosion-box.opened .box-center { opacity: 0; transform: scale(0.3); pointer-events: none; }

    .flap-content { display: none; flex-direction: column; align-items: center; justify-content: center; height: 100%; width: 100%; }
    .explosion-box.opened .flap-content { display: flex; }
    .flap h3 { font-size: 12px; color: #ff8a8a; margin-bottom: 6px; font-weight: 600; }

    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; font-size: 9px; width: 100%; }
    .cal-day { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 3px; }
    .cal-day.highlight { background: #ff4d6d; font-weight: bold; position: relative; }
    .cal-day.highlight::after { content: "❤️"; position: absolute; font-size: 7px; top: -4px; right: -1px; }

    .baby-gallery { display: flex; flex-wrap: wrap; gap: 3px; justify-content: center; }
    .baby-gallery img { width: 38px; height: 38px; object-fit: cover; border-radius: 6px; }

    .counter { font-size: 18px; font-weight: 300; color: #ff8a8a; }
    .counter-label { font-size: 10px; opacity: 0.75; margin-top: 2px; }

    .heart-container {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%) scale(0); z-index: 30; cursor: pointer;
      transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .heart-container.visible { transform: translate(-50%, -50%) scale(1); }
    .heart {
      width: 120px; height: 110px; position: relative;
      filter: drop-shadow(0 0 20px rgba(193,18,31,0.75));
    }
    .heart::before, .heart::after {
      content: ""; position: absolute; width: 65px; height: 100px;
      background: #c1121f; border-radius: 65px 65px 0 0;
    }
    .heart::before { left: 60px; transform: rotate(-45deg); transform-origin: 0 100%; }
    .heart::after { left: 0; transform: rotate(45deg); transform-origin: 100% 100%; }
    .heart-text {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -30%);
      font-size: 13px; font-weight: 600; color: white; z-index: 2; pointer-events: none;
    }

    #letter-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.9);
      display: none; align-items: center; justify-content: center; z-index: 100; padding: 20px;
    }
    #letter-overlay.visible { display: flex; animation: fadeIn 0.4s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .letter-paper {
      background: #f8f1e9; color: #2c2c2c; width: 100%; max-width: 370px; max-height: 80vh;
      border-radius: 10px; padding: 28px 24px; box-shadow: 0 25px 60px rgba(0,0,0,0.6);
      overflow-y: auto; position: relative; animation: unroll 0.8s ease;
      font-family: Georgia, serif; line-height: 1.65;
    }
    @keyframes unroll { from { transform: scaleY(0.1); opacity: 0.3; } to { transform: scaleY(1); opacity: 1; } }
    .letter-paper h2 { text-align: center; color: #9b0b14; margin-bottom: 18px; font-size: 18px; }
    .letter-paper p { margin-bottom: 13px; font-size: 15px; }
    .letter-signature { margin-top: 22px; text-align: right; font-style: italic; color: #9b0b14; }
    .close-letter { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 26px; color: #999; }

    .tap-hint {
      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
      font-size: 14px; opacity: 0.6; z-index: 20; animation: pulse 2s infinite;
    }
    @keyframes pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 0.9; } }
    .tap-hint.hidden { display: none; }
  </style>
</head>
<body>

  <audio id="bg-music" loop playsinline>
    <source src="musica.mp3" type="audio/mpeg">
  </audio>

  <!-- LOCK SCREEN -->
  <div id="lock-screen">
    <div class="lock-time" id="lock-time">00:00</div>
    <div class="lock-date" id="lock-date">lunes, 26 de octubre</div>
    <div class="pin-dots">
      <div class="pin-dot"></div><div class="pin-dot"></div><div class="pin-dot"></div><div class="pin-dot"></div>
      <div class="pin-dot"></div><div class="pin-dot"></div><div class="pin-dot"></div><div class="pin-dot"></div>
    </div>
    <div class="pin-pad">
      <button class="pin-btn" data-num="1">1</button>
      <button class="pin-btn" data-num="2">2</button>
      <button class="pin-btn" data-num="3">3</button>
      <button class="pin-btn" data-num="4">4</button>
      <button class="pin-btn" data-num="5">5</button>
      <button class="pin-btn" data-num="6">6</button>
      <button class="pin-btn" data-num="7">7</button>
      <button class="pin-btn" data-num="8">8</button>
      <button class="pin-btn" data-num="9">9</button>
      <button class="pin-btn empty"></button>
      <button class="pin-btn" data-num="0">0</button>
      <button class="pin-btn empty"></button>
    </div>
    <div class="error-msg" id="error-msg">PIN incorrecto</div>
  </div>

  <!-- MAIN -->
  <div id="main-content">
    <div class="explosion-box" id="explosion-box">
      <!-- Arriba: Calendario -->
      <div class="flap top">
        <div class="flap-content">
          <h3>Nuestro día</h3>
          <div style="font-size:10px;margin-bottom:4px;color:#ffb3b3;">Octubre 2026</div>
          <div class="calendar-grid" id="calendar-grid"></div>
        </div>
        <span>Calendario</span>
      </div>

      <!-- Derecha: Fotos -->
      <div class="flap right">
        <div class="flap-content">
          <h3>el amor de mi vida cuando era bb</h3>
          <div class="baby-gallery">
            <img src="bb1.jpg" alt="1">
            <img src="bb2.jpg" alt="2">
            <img src="bb3.jpg" alt="3">
            <img src="bb4.jpg" alt="4">
            <img src="bb5.jpg" alt="5">
            <img src="bb6.jpg" alt="6">
          </div>
        </div>
        <span>Fotos bb</span>
      </div>

      <!-- Abajo: Contador -->
      <div class="flap bottom">
        <div class="flap-content">
          <h3>Desde el 6 de octubre</h3>
          <div class="counter" id="counter">0 días</div>
          <div class="counter-label">juntos</div>
          <div class="counter-label" id="time-detail" style="margin-top:4px;"></div>
        </div>
        <span>Contador</span>
      </div>

      <!-- Izquierda: Dibujo -->
      <div class="flap left">
        <div class="flap-content">
          <h3>Hecho por mí</h3>
          <img src="dibujo.jpg" style="width:100px;height:100px;object-fit:cover;border-radius:10px;" alt="Dibujo">
        </div>
        <span>Dibujo</span>
      </div>

      <div class="box-center" id="box-center">🎁</div>
    </div>

    <div class="heart-container" id="heart-container">
      <div class="heart"></div>
      <div class="heart-text">Toca</div>
    </div>

    <div class="tap-hint" id="tap-hint">Toca la caja para abrirla 🖤</div>
  </div>

  <!-- CARTA -->
  <div id="letter-overlay">
    <div class="letter-paper">
      <button class="close-letter" id="close-letter">×</button>
      <h2>Para Bladimir 🖤</h2>
      <p>Hoy amor ya cumplimos nuestro primer mes, y espero que sea el primero de muchos más, porque no quiero que esto acabe.</p>
      <p>En este tiempo que te he conocido y que soy tu novia me he sentido muy feliz, me encanta la forma en la que me tratas, en la que me das amor, en la que me entiendes. Nunca nadie me había tenido tanta paciencia como tú la tienes conmigo.</p>
      <p>Sé que no soy la mejor novia, estoy intentando cambiar por ti, para ser mejor persona. Sé que a veces la embarró, y la cago muy feo, y quizás pienses que no me importa lo que hago o en qué te afecta.</p>
      <p>Hace mucho no sentía este amor como el que siento por ti, es sincero, y cada día te amo más. No me cansaría de amarte, porque sé que te mereces todo el amor que te puedo dar.</p>
      <p>Gracias por estar conmigo, y por quererme así como soy.</p>
      <p>Te amo mucho y feliz primer mes.</p>
      <div class="letter-signature">
        DE: Bry<br>
        PARA: Bladimir 🖤
      </div>
    </div>
  </div>

  <script>
    const music = document.getElementById("bg-music");
    const correctPin = "06102026";
    let currentPin = "";
    const dots = document.querySelectorAll(".pin-dot");
    const errorMsg = document.getElementById("error-msg");

    function updateLockTime() {
      const now = new Date();
      document.getElementById("lock-time").textContent =
        now.getHours().toString().padStart(2,"0") + ":" + now.getMinutes().toString().padStart(2,"0");
      const days = ["domingo","lunes","martes","miércoles","jueves","viernes","sábado"];
      const months = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
      document.getElementById("lock-date").textContent =
        `${days[now.getDay()]}, ${now.getDate()} de ${months[now.getMonth()]}`;
    }
    updateLockTime();
    setInterval(updateLockTime, 10000);

    document.querySelectorAll(".pin-btn[data-num]").forEach(btn => {
      btn.addEventListener("click", () => {
        if (currentPin.length >= 8) return;
        currentPin += btn.dataset.num;
        dots.forEach((dot, i) => dot.classList.toggle("filled", i < currentPin.length));
        if (currentPin.length === 8) {
          setTimeout(() => {
            if (currentPin === correctPin) {
              music.play().catch(()=>{});
              document.getElementById("lock-screen").classList.add("hidden");
              setTimeout(() => {
                document.getElementById("lock-screen").style.display = "none";
                document.getElementById("main-content").classList.add("active");
              }, 600);
            } else {
              errorMsg.classList.add("show");
              currentPin = "";
              dots.forEach(d => d.classList.remove("filled"));
              setTimeout(() => errorMsg.classList.remove("show"), 1400);
            }
          }, 180);
        }
      });
    });

    const box = document.getElementById("explosion-box");
    const heart = document.getElementById("heart-container");
    const hint = document.getElementById("tap-hint");

    document.getElementById("box-center").addEventListener("click", openBox);
    box.addEventListener("click", function(e) {
      if (!box.classList.contains("opened")) openBox();
    });

    function openBox() {
      if (box.classList.contains("opened")) return;
      box.classList.add("opened");
      hint.classList.add("hidden");
      setTimeout(() => heart.classList.add("visible"), 700);
    }

    // Calendario
    (function() {
      const grid = document.getElementById("calendar-grid");
      for (let i = 0; i < 4; i++) grid.appendChild(document.createElement("div"));
      for (let d = 1; d <= 31; d++) {
        const day = document.createElement("div");
        day.className = "cal-day" + (d === 6 ? " highlight" : "");
        day.textContent = d;
        grid.appendChild(day);
      }
    })();

    // Contador
    function updateCounter() {
      const start = new Date("2026-10-06T15:56:00");
      const end = new Date("2026-11-06T23:59:59");
      const now = new Date();
      const daysTogether = Math.floor((now - start) / 86400000);
      const daysLeft = Math.max(0, Math.ceil((end - now) / 86400000));
      document.getElementById("counter").textContent = daysTogether + " días";
      document.getElementById("time-detail").textContent =
        daysLeft > 0 ? daysLeft + " días para el 6 de noviembre" : "¡Llegamos!";
    }
    updateCounter();
    setInterval(updateCounter, 60000);

    // Carta
    heart.addEventListener("click", () => document.getElementById("letter-overlay").classList.add("visible"));
    document.getElementById("close-letter").addEventListener("click", () => {
      document.getElementById("letter-overlay").classList.remove("visible");
    });
    document.getElementById("letter-overlay").addEventListener("click", (e) => {
      if (e.target.id === "letter-overlay") document.getElementById("letter-overlay").classList.remove("visible");
    });
  </script>
</body>
</html>
